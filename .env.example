# PostHog — chmura US
# Klucz znajdziesz w: PostHog → Settings → Project → Project API Key (zaczyna sie od phc_)
# Skopiuj ten plik do .env.local i uzupelnij klucz.
# Region zmieniasz samym HOST-em: https://us.i.posthog.com albo https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
